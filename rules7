rules:
  - id: cerber-file-received-callback-empty
    message: >
      onFileReceived() callback has an empty implementation. CerberSDK's secure
      file transfer sends files through CerberTransferActivity and notifies the
      host app via this callback. An empty implementation means received files
      are silently dropped.
    severity: WARNING
    languages:
      - kotlin
    metadata:
      category: cerber-sdk-security
      subcategory: file-transfer-ignored
      confidence: INFO
    pattern-either:
      - pattern: |
          override fun onFileReceived($URI: Uri, $PKG: String) { }
      - pattern: |
          fun onFileReceived($URI: Uri, $PKG: String) { }
      - pattern: |
          override fun onFileReceived($URI: Uri, $PKG: String) = Unit


