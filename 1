### 2. Необходимо реализовать новые методы CerberDelegate

```swift
// Добавить в extension CerberFlowCoordinator: CerberDelegate:

func didDetectJailbreak(isJailbroken: Bool) {
    guard isJailbroken else { return }
    eventsService.add(JailbreakDetectedEvent())
    cerber.wipe(reason: "jailbreak_detected")
}

func onNoAuthDetected() {
    eventsService.add(NoAuthEvent())
    cerber.wipe(reason: "no_auth_detected")
}

func onLogout() {
    eventsService.add(LogoutEvent())
    keychainService.delete(key: .accessToken)
}

func onFileReceived(file: CerberFile) {
    eventsService.add(FileReceivedEvent(fileId: file.id))
    secureStore.save(file)
}
```

