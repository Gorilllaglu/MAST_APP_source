```

**iOS (SberApps):**
```swift
// Apps/Configs/AppConfiguration.swift — источник значения

enum AppConfiguration {
    enum BuildType: String {
        case dev          // Dev
        case majorcheck   // ИФТ
        case majorgo      // ПСИ
        case prod         // Пром
        case testProd     // Пром с тестовым бандлом
    }
    
    static let buildType = BuildType(rawValue: ...) ?? .prod
    
    static var cerberMode: CerberSDK.Mode {
        switch buildType {
        case .dev: return .dev2
        case .majorcheck: return .majorCheck
        case .majorgo: return .majorGo
        case .prod, .testProd: return .prod
        }
    }
}

// Apps/FlowCooridnators/CerberFlowCoordinator.swift — использование

cerber.options = SetupOptions(
    mode: AppConfiguration.cerberMode,   // ← ПЕРЕМЕННАЯ (computed property)
    loginOptions: AppConfiguration.loginOptions,
    isPasswordlessEnabled: true,
    jailbreakCheckerType: .lite,
    accessGroupID: nil,
    loggerOptions: [.logEnabled, .debug, .fileLogEnabled],
    enableTestSSLPinning: true
)
```

> **Вывод:** iOS-код **соответствует** Android-паттерну V-3. `cerberMode` — computed property с `switch` по `buildType` из Info.plist. В продуктовом билде всегда `.prod`. Статика (Semgrep) не может доказать безопасность, но исходник показывает корректную реализацию. Правило `build-type-variable.yml` создаст negative-фикстуру для этого кейса.

