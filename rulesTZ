rules:
  - id: cerber-secure-check-wrong-state-comparison
    message: >
      SecureChecker.performChecks() result is compared against a single unsafe
      state instead of DEVICE_COMPLIANT. Every other unsafe state passes this
      check: comparing against ROOT_DETECTED alone lets EMULATOR_DETECTED and
      DEVICE_LOCKED through. Compare against DEVICE_COMPLIANT and treat
      everything else as non-compliant.
    severity: ERROR
    languages:
      - kotlin
    metadata:
      category: cerber-sdk-security
      subcategory: check-result-ignored
      cwe: "CWE-252: Unchecked Return Value"
      confidence: HIGH
    pattern-either:
      - pattern: $C.performChecks() == SecureCheck.ROOT_DETECTED
      - pattern: $C.performChecks() != SecureCheck.ROOT_DETECTED
      - pattern: $C.performChecks() == SecureCheck.EMULATOR_DETECTED
      - pattern: $C.performChecks() != SecureCheck.EMULATOR_DETECTED
      - pattern: $C.performChecks() == SecureCheck.DEVICE_LOCKED
