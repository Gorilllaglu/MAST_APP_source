const csrf = document.querySelector('meta[name=_csrf]')?.content, H = csrf ? {'X-CSRF-TOKEN': csrf} : {};
for (const v of ['FULL_NAME', 'FIO', 'LOGIN']) { const r = await fetch(`/api/v160/unit/directly-subordinate/-1/UNIT?nameType=${v}&withEmps=false`, {credentials: 'same-origin', headers: H}); console.log(v, r.status, r.ok ? '' : (await r.text()).slice(0, 120)); }
