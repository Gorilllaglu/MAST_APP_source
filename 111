                  ...
                  when ($RESULT) {
                    $CASE -> ...
                  }
              - pattern-not-inside: |
                  $RESULT = $BUF.write(...)
                  ...
                  when ($RESULT) {
                    $CASE -> ...
                  }
              - pattern-not-inside: |
                  val $RESULT = $BUF.write(...)
                  ...
                  if ($RESULT == $ANY) {
                    ...
                  }
              - pattern-not-inside: |
                  val $RESULT = $BUF.write(...)
                  ...
                  if ($RESULT != $ANY) {
                    ...
                  }
              - pattern-not-inside: |
